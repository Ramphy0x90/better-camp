# Copy this to .env and fill in your values

# Get these from https://integrate.37signals.com
BASECAMP_CLIENT_ID=your_client_id_here
BASECAMP_CLIENT_SECRET=your_client_secret_here

# Your Basecamp account ID (visible in the URL when logged in)
BASECAMP_ACCOUNT_ID=3501249

# Where Basecamp sends the user after login
# For local Docker use, keep this as-is
BASECAMP_REDIRECT_URI=https://yourdomain.com/auth/callback

# Random secret string — used for state param signing
SECRET_KEY=change-me-to-something-random

# URL where the frontend is served (used for post-auth redirect)
FRONTEND_URL=https://yourdomain.com

# App-level login credentials (set these before deploying)
APP_USERNAME=your_username_here
APP_PASSWORD=your_password_here
